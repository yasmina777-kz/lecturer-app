# AI Mentor — copy to .env and fill only the services you need.
# Local launch: python3 scripts/launch.py (or start.command).
# Priority: process environment > local.config.json > .env > application defaults.
# Values are literal: no shell commands, ${VARIABLE} expansion or multiline values.
# Never use VITE_ variables for secrets: those become visible in the browser.

# Text generation and questions (optional; empty = demo mode)
OPENAI_API_KEY=
AI__Model=gpt-4o-mini
AI__BaseUrl=https://api.openai.com/v1/
AI__TranscriptionModel=whisper-1

# Azure Speech: use the key and region of the SAME Speech resource.
# Both empty = the browser's installed voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local database; SQLite is created automatically.
Database__Provider=Sqlite
# For PostgreSQL, change the provider to Postgres and set a connection string:
# ConnectionStrings__Default="Host=localhost;Port=5432;Database=lecturer;Username=lecturer;Password=REPLACE_ME"
# Optional absolute directory for the local SQLite database and session key:
# DataDirectory=/absolute/path/to/private-app-data

# Docker Compose only: set your own strong database password before launching Docker.
# Compose uses PostgreSQL regardless of the local Database__Provider above.
POSTGRES_PASSWORD=

# Optional session signing secret (32+ bytes). When omitted, generated in App_Data.
# Jwt__Key=

# Optional custom model/provider prices, USD per 1 million tokens.
# Leave unset to use the known OpenAI GPT-4o mini tariff or display unknown cost.
# AI__InputUsdPerMillion=0.15
# AI__CachedUsdPerMillion=0.075
# AI__OutputUsdPerMillion=0.60
