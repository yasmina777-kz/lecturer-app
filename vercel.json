{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "node scripts/prepare-cloud-assets.mjs && npm run build",
      "outputDirectory": "dist",
      "headers": [
        {
          "source": "/assets/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/models/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800" }]
        },
        {
          "source": "/research/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800" }]
        },
        {
          "source": "/avatars/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=604800, stale-while-revalidate=604800" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        }
      ],
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "mentor": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "krsl",
          "format": "url",
          "env": "KRSL_PRIVATE_SERVICE_URL"
        }
      ]
    },
    "krsl": {
      "root": "ml/krsl",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "mentor" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
